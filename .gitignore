# Carpeta de assets originales de edición (no van al repo)
assets/

# Excepción: fuentes tipográficas SÍ van al repo
!public/assets/nutfruit-recetas/*.ttf
!public/assets/nutfruit-recetas/*.woff
!public/assets/nutfruit-recetas/*.woff2

# Archivos temporales y carpetas de trabajo
